---
import Layout from '../../layouts/Layout.astro';
import { useTranslations } from '../../utils/i18n';

const lang = 'az'; // Default root language
const t = useTranslations(lang);
---

<Layout title={`Parfumstore.az - ${t('catalog.findScent')}`}>
  <div class="animate-fade-in" data-lang={lang}>
    <div class="h-32"></div>

    <section class="section-luxury pt-6 md:pt-12 min-h-screen">
       <div class="max-w-6xl mx-auto px-6">
          
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-black/5 dark:border-white/5 pb-8 mb-12">
             <div class="flex flex-col gap-2">
                <a href="/catalog" class="group flex items-center gap-2 text-[10px] tracking-[0.2em] text-gray-400 hover:text-[#d4af37] transition-colors uppercase font-medium">
                   <svg class="w-3 h-3 transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                   {t('catalog.backToCatalog')}
                </a>
                <h1 class="text-2xl md:text-4xl font-serif tracking-[0.1em] uppercase text-[#31251c] dark:text-[#E6D5C3] mt-2">
                   {t('catalog.findScent')}
                </h1>
             </div>

             <div class="flex flex-wrap items-center gap-4">
                <button type="button" class="bg-gradient-to-r from-[#d4af37] to-[#D97706] text-black px-6 py-2.5 text-[9px] font-bold tracking-[0.2em] uppercase rounded-sm border-none shadow-[0_4px_15px_-5px_rgba(212,175,55,0.4)] transition-transform hover:scale-105 active:scale-95">{t('catalog.addAccord')}</button>
                <button type="button" class="border border-[#d4af37]/40 text-[#d4af37] px-6 py-2.5 text-[9px] font-bold tracking-[0.2em] uppercase rounded-sm hover:bg-[#d4af37]/10 transition-colors">{t('catalog.copyLink')}</button>
                <button type="button" class="border border-[#8a0303]/40 text-[#8a0303] px-6 py-2.5 text-[9px] font-bold tracking-[0.2em] uppercase rounded-sm hover:bg-[#8a0303]/10 transition-colors">{t('catalog.reset')}</button>
             </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-[300px_1fr] gap-16 min-h-[500px]">
             <div class="flex flex-col">
                <h3 class="text-[10px] font-serif uppercase tracking-[0.3em] mb-6 text-gray-500 dark:text-[#d4af37]/60 font-medium">{t('catalog.basedOn')}</h3>
                <div class="aspect-[4/5] w-full border border-black/5 dark:border-white/5 bg-black/5 dark:bg-white/5 flex flex-col items-center justify-center p-8 rounded-sm group transition-all duration-500 hover:border-[#d4af37]/30 cursor-pointer overflow-hidden relative">
                   <div class="w-14 h-14 rounded-full border border-gray-300 dark:border-gray-700 flex items-center justify-center mb-6 group-hover:border-[#d4af37] group-hover:bg-[#d4af37]/5 transition-all duration-500">
                      <svg class="w-6 h-6 text-gray-400 dark:text-gray-600 group-hover:text-[#d4af37]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
                   </div>
                   <p class="text-[10px] uppercase tracking-[0.2em] text-gray-400 dark:text-gray-500 text-center leading-loose max-w-[160px] z-10 font-light group-hover:text-gray-300 transition-colors uppercase">{t('catalog.addPerfumePrompt')}</p>
                </div>
                <button type="button" disabled class="mt-6 text-[9px] uppercase tracking-[0.3em] text-gray-400 dark:text-gray-700 opacity-50 cursor-not-allowed text-left underline underline-offset-4 font-medium">{t('catalog.delete')}</button>
             </div>

             <div class="bg-black/5 dark:bg-black/30 border border-black/5 dark:border-white/5 rounded-sm p-12 flex items-center justify-center relative overflow-hidden group/canvas">
                <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(circle_at_center,_#d4af37_0%,_transparent_70%)] transition-opacity group-hover/canvas:opacity-20 duration-1000"></div>
                <div class="relative z-10 flex flex-col items-center opacity-10">
                   <p class="text-[10px] uppercase tracking-[0.8em] text-gray-700 dark:text-gray-500 font-serif italic mb-4 select-none">SCENT_LAB_PROFILE</p>
                   <div class="w-12 h-[1px] bg-gray-800"></div>
                </div>
             </div>
          </div>

          <div class="mt-24 max-w-2xl mx-auto border-b border-black/10 dark:border-white/10 flex items-center py-6 transition-all duration-500 hover:border-[#d4af37] focus-within:border-[#d4af37] group">
             <span class="text-[#d4af37] text-2xl font-light mr-6 select-none transition-transform group-hover:scale-110">+</span>
             <input type="text" placeholder={t('catalog.addAccord')} class="bg-transparent border-none text-[13px] uppercase tracking-[0.3em] font-sans font-extralight focus:outline-none focus:ring-0 w-full text-[#E6D5C3] placeholder-gray-800" />
             <button type="button" class="text-gray-800 hover:text-[#8a0303] px-4"><svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M6 18L18 6M6 6l12 12"></path></svg></button>
          </div>
       </div>
    </section>
  </div>
</Layout>
