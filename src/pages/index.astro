---
const lang = Astro.currentLocale || 'az';
const t = useTranslations(lang);
import { useTranslations } from '../utils/i18n';
import Layout from '../layouts/Layout.astro';
import HeroSlider from '../components/HeroSlider.astro';
---

<Layout title="Parfumstore.az - Editorial Luxury Perfumes">
  <HeroSlider />

  <!-- ═══════════════════════════════════════════
       SECTION 2: ABOUT — Editorial Brand Story
       ═══════════════════════════════════════════ -->
  <section id="about" class="section-luxury">
    <div class="max-w-screen-xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24 items-start">
        <!-- Left: Text -->
        <div>
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-normal tracking-widest uppercase mb-10">
            {t('home.about')}</h2>
          <div class="space-y-6" style="color: var(--text-muted);">
            <p>
              {t('home.about_p1')}
            </p>
            <p>
              {t('home.about_p2')}
            </p>
            <p>
              {t('home.about_p3')}
            </p>
          </div>
        </div>

        <!-- Right: Visual Placeholder -->
        <div class="aspect-[3/4] flex items-center justify-center transition-all duration-700" style="border: 1px solid var(--border); background-color: var(--bg);">
          <div class="text-center px-8">
            <div class="w-20 h-20 mx-auto mb-6 rounded-full flex items-center justify-center" style="border: 1px solid var(--accent);">
              <svg class="w-10 h-10" style="color: var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
            </div>
            <p class="text-xs font-normal tracking-widest uppercase" style="color: var(--accent);">{t('home.editorialImage')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 4: BESTSELLERS — Product Grid
       ═══════════════════════════════════════════ -->
  <section id="collection" class="section-luxury">
    <div class="max-w-screen-xl mx-auto">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-normal tracking-widest uppercase text-center mb-6">
        {t('home.bestsellers')}</h2>
      <div class="section-divider"></div>

      <!-- 4-Column Product Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
        <!-- Product 1 -->
        <div class="product-card">
          <div class="product-image">
            <svg class="w-16 h-24 opacity-20" style="color: var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 60 100">
              <path d="M 25 10 L 30 5 L 35 10 L 35 70 Q 30 80 25 70 Z" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </div>
          <h3 class="product-title">Midnight Reverie</h3>
          <p class="product-price">€380</p>
        </div>

        <!-- Product 2 -->
        <div class="product-card">
          <div class="product-image">
            <svg class="w-16 h-24 opacity-20" style="color: var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 60 100">
              <path d="M 25 10 L 30 5 L 35 10 L 35 70 Q 30 80 25 70 Z" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </div>
          <h3 class="product-title">Pearl Essence</h3>
          <p class="product-price">€290</p>
        </div>

        <!-- Product 3 -->
        <div class="product-card">
          <div class="product-image">
            <svg class="w-16 h-24 opacity-20" style="color: var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 60 100">
              <path d="M 25 10 L 30 5 L 35 10 L 35 70 Q 30 80 25 70 Z" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </div>
          <h3 class="product-title">Amber Dreams</h3>
          <p class="product-price">€310</p>
        </div>

        <!-- Product 4 -->
        <div class="product-card">
          <div class="product-image">
            <svg class="w-16 h-24 opacity-20" style="color: var(--accent);" fill="none" stroke="currentColor" viewBox="0 0 60 100">
              <path d="M 25 10 L 30 5 L 35 10 L 35 70 Q 30 80 25 70 Z" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </div>
          <h3 class="product-title">Rose Noir</h3>
          <p class="product-price">€325</p>
        </div>
      </div>

      <!-- More Products Button -->
      <div class="text-center mt-16 md:mt-20">
        <a href="#" class="btn-theme-lg">{t('home.moreProducts')}</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 5: PHILOSOPHY — 3-Block Layout
       ═══════════════════════════════════════════ -->
  <section id="philosophy" class="section-luxury">
    <div class="max-w-screen-xl mx-auto">
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-normal tracking-widest uppercase text-center mb-6">
        {t('home.philosophy')}</h2>
      <div class="section-divider"></div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
        <!-- Block 1: Why Us -->
        <div class="philosophy-block">
          <div class="philosophy-number">01</div>
          <h3 class="philosophy-title">{t('home.whyUs')}</h3>
          <p class="philosophy-text">
            {t('home.whyUsDesc')}
          </p>
        </div>

        <!-- Block 2: Why Niche? -->
        <div class="philosophy-block">
          <div class="philosophy-number">02</div>
          <h3 class="philosophy-title">{t('home.whyNiche')}</h3>
          <p class="philosophy-text">
            {t('home.whyNicheDesc')}
          </p>
        </div>

        <!-- Block 3: Notes & Evolution -->
        <div class="philosophy-block">
          <div class="philosophy-number">03</div>
          <h3 class="philosophy-title">{t('home.notesEvolution')}</h3>
          <p class="philosophy-text">
            {t('home.notesDesc')}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SECTION 6: INFORMATION — Footer Content
       ═══════════════════════════════════════════ -->
  <section id="contact" class="section-luxury" style="border-bottom: none;">
    <div class="max-w-screen-xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 md:gap-8">

        <!-- Contacts -->
        <div>
          <h4 class="footer-heading">{t('home.contacts')}</h4>
          <div class="space-y-3">
            <p class="footer-text">
              <a href="https://wa.me/994505555555" class="footer-link" target="_blank" rel="noopener">WhatsApp: +994 50 555 5555</a>
            </p>
            <p class="footer-text">
              <a href="tel:+994505555555" class="footer-link">Tel: +994 50 555 5555</a>
            </p>
            <p class="footer-text">
              <a href="mailto:hello@parfumstore.az" class="footer-link">hello@parfumstore.az</a>
            </p>
          </div>
        </div>

        <!-- Location -->
        <div>
          <h4 class="footer-heading">{t('home.location')}</h4>
          <div class="space-y-3">
            <p class="footer-text">{t('home.locationDesc1')}</p>
            <p class="footer-text">{t('home.locationDesc2')}</p>
            <p class="footer-text">{t('home.locationDesc3')}</p>
          </div>
        </div>

        <!-- {t('home.privacyPolicy')} -->
        <div>
          <h4 class="footer-heading">{t('home.legal')}</h4>
          <div class="space-y-3">
            <p><a href="#" class="footer-link">{t('home.privacyPolicy')}</a></p>
            <p><a href="#" class="footer-link">{t('home.termsService')}</a></p>
            <p><a href="#" class="footer-link">{t('home.returnPolicy')}</a></p>
          </div>
        </div>

        <!-- Subscribe -->
        <div>
          <h4 class="footer-heading">{t('home.stayUpdated')}</h4>
          <form class="space-y-4">
            <input
              type="email"
              placeholder={t("home.placeholderEmail")}
              class="footer-input"
              required
            />
            <button type="submit" class="btn-theme w-full text-center">{t('home.subscribe')}</button>
          </form>
          <p class="footer-text mt-3" style="font-size: 0.65rem;">{t('home.weRespect')}</p>
        </div>

      </div>

      <!-- Copyright -->
      <div class="mt-16 pt-8" style="border-top: 1px solid var(--border);">
        <p class="text-center text-xs tracking-wider" style="color: var(--text-muted);">&copy; 2026 PARFUMSTORE.AZ. All rights reserved.</p>
      </div>
    </div>
  </section>

  <script>
    // Smooth anchor scrolling
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function (e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  </script>
</Layout>
