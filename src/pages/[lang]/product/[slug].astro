---
// FORCE REBUILD: Hot Reloading to fetch latest Sanity Production Data for Accords
import Layout from '../../../layouts/Layout.astro';
import { sanityClient } from '../../../lib/sanity';
import imageUrlBuilder from '@sanity/image-url';

import { useTranslations } from '../../../utils/i18n';

export async function getStaticPaths() {
  const products = await sanityClient.fetch('*[_type == "product" && defined(slug.current)]{ name, letter, logo, slug, price, description, fragranceNotes, "accords": accords[] { _key, name, color, value }, shippingInfo, gender, "brandName": coalesce(brand->name, ""), "brandSlug": brand->slug.current }');
  
  const locales = ['az', 'ru', 'en'];
  
  return products.flatMap((brand) => {
    return locales.map(lang => {
      return {
        params: { lang, slug: brand.slug.current },
        props: { brand },
      };
    });
  });
}

const { brand } = Astro.props;
const lang = Astro.params.lang || 'az';
const t = useTranslations(lang);

const builder = imageUrlBuilder(sanityClient);
function urlFor(source) {
  return builder.image(source);
}

// Extract localized data
const descriptionBlocks = brand.description?.[lang] || brand.description?.az || [];
const notes = brand.fragranceNotes?.[lang] || brand.fragranceNotes?.az || brand.fragranceNotes || {};
const shippingText = brand.shippingInfo?.[lang] || brand.shippingInfo?.az || '';

const genderMap = {
  'Мужской': { ru: "Для мужчин", en: "Pour Homme", az: "Kişilər üçün" },
  'Женский': { ru: "Для женщин", en: "Pour Femme", az: "Qadınlar üçün" },
  'Унисекс': { ru: "Унисекс", en: "Unisex", az: "Uniseks" }
};
const displayGender = brand.gender ? (genderMap[brand.gender]?.[lang] || brand.gender) : "";
---

<Layout title={`${brand.name} - Parfumstore.az`}>
  <div class="animate-fade-in bg-[#fdfdfd] dark:bg-[#0b0b0b] transition-colors duration-500" style="min-height: 100vh;">
    <div class="h-32"></div>

    <section class="pb-16 pt-8 md:pt-12">
      <div class="max-w-5xl mx-auto px-6 lg:px-12">
        
        <!-- Breadcrumbs -->
        <nav class="mb-10 text-[10px] md:text-xs tracking-widest uppercase opacity-90 flex flex-wrap items-center gap-2 text-gray-700 dark:text-[#E5E7EB] transition-colors duration-500 font-sans font-semibold leading-relaxed">
          <a href={`/${lang === 'az' ? '' : lang}`} class="hover:text-[#D97706] transition-colors duration-300">{t('nav.home') || 'Home'}</a> 
          <span class="opacity-50">/</span>
          <a href={`/${lang}/catalog`} class="hover:text-[#D97706] transition-colors duration-300">{t('nav.catalog') || 'Catalog'}</a>
          {brand.brandName && (
             <>
               <span class="opacity-50">/</span>
               <a href={`/${lang}/brand/${brand.brandSlug}`} class="hover:text-[#D97706] transition-colors duration-300">{brand.brandName}</a>
             </>
          )}
          <span class="opacity-50">/</span>
          <span class="text-[#D97706]">{brand.name}</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
          
          <!-- Large Image Column -->
          <div class="w-full flex flex-col items-center">
            <div class="w-full aspect-[4/5] max-w-sm mx-auto bg-white dark:bg-[#111] border border-black/5 dark:border-white/5 p-10 lg:p-14 flex justify-center items-center rounded-sm transition-colors duration-500 shadow-sm dark:shadow-none animate-fade-in">
              {brand.logo ? (
                <img 
                  src={urlFor(brand.logo).width(600).url()} 
                  alt={`${brand.name} logo`} 
                  class="w-full h-full object-contain drop-shadow-xl opacity-95 mix-blend-multiply dark:mix-blend-normal"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-white/20 uppercase tracking-widest text-[10px]">
                  No Image
                </div>
              )}
            </div>

          </div>
          
          <!-- Product Info & Accordions Column -->
          <div class="flex flex-col pt-4 lg:pt-12 text-gray-900 dark:text-[#F3F4F6] transition-colors duration-500">
            <!-- Main Title & Price -->
            <div class="mb-10 lg:mb-12">
              <h1 class="text-xl md:text-2xl font-serif tracking-[0.15em] uppercase mb-4 opacity-90 leading-tight">
                {brand.name}
                {displayGender && (
                  <span class="text-[10px] md:text-xs font-sans font-semibold tracking-widest ml-2 align-middle text-[#8B6D43] dark:text-[#D97706]">
                    ({displayGender})
                  </span>
                )}
              </h1>
              {brand.price && (
                <p class="text-sm md:text-base font-sans font-light tracking-widest text-[#D97706] mt-4 uppercase">
                  {brand.price} ₼
                </p>
              )}
              {!brand.price && (
                <p class="text-[9px] md:text-[10px] font-sans tracking-widest uppercase opacity-60 text-[#D97706]">
                  Exclusive Collection
                </p>
              )}
            </div>
            
            <!-- Accordions Container -->
            <div class="w-full border-t border-black/10 dark:border-white/10 transition-colors duration-500 font-sans font-light leading-relaxed">
              
              <!-- DESCRIPTION Accordion -->
              <details class="group border-b border-black/10 dark:border-white/10 transition-colors duration-500" open>
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none py-6 text-xs tracking-[0.25em] uppercase hover:text-[#D97706] transition-colors duration-300">
                  <span>{t('product.description')}</span>
                  <span class="transition duration-300 group-open:rotate-180">
                    <svg fill="none" height="18" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="18" class="text-gray-400 dark:text-white/50 group-hover:text-[#D97706]">
                      <path d="M6 9l6 6 6-6"></path>
                    </svg>
                  </span>
                </summary>
                <div class="pb-8 pt-2 text-gray-700 dark:text-[#D1D5DB] text-xs md:text-sm leading-[1.8] md:leading-loose tracking-wide opacity-80 animate-slide-down transition-colors duration-500">
                  {descriptionBlocks.length > 0 ? (
                    descriptionBlocks.map((block) => {
                      if (block._type !== 'block' || !block.children) return null;
                      return <p class="mb-4 last:mb-0">{block.children.map(c => c.text).join('')}</p>;
                    })
                  ) : (
                    <p>{t('product.fallbackDesc')}</p>
                  )}
                </div>
              </details>
              
              <!-- FRAGRANCE NOTES Accordion -->
              <details class="group border-b border-black/10 dark:border-white/10 transition-colors duration-500">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none py-6 text-xs tracking-[0.25em] uppercase hover:text-[#D97706] transition-colors duration-300">
                  <span>{t('product.fragranceNotes')}</span>
                  <span class="transition duration-300 group-open:rotate-180">
                    <svg fill="none" height="18" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="18" class="text-gray-400 dark:text-white/50 group-hover:text-[#D97706]">
                      <path d="M6 9l6 6 6-6"></path>
                    </svg>
                  </span>
                </summary>
                <div class="pb-8 pt-2 text-gray-700 dark:text-[#D1D5DB] text-xs md:text-sm leading-[1.8] md:leading-loose tracking-wide opacity-80 animate-slide-down transition-colors duration-500">

                  {/* FRAGRANCE ACCORDS */}
                  {brand.accords && brand.accords.length > 0 && (
                    <div class="accords-wrapper mt-4 w-full flex flex-col gap-[4px] pt-2">
                      {brand.accords
                        .sort((a, b) => b.value - a.value)
                        .map((accord) => {
                          // Get the current language dynamically
                          const currentLang = Astro.currentLocale || Astro.params.lang || 'az'; 
                          
                          // Safely extract the translation, fallback to ru, then en
                          const labelText = accord.name?.[currentLang] || accord.name?.ru || accord.name?.en || 'N/A';
                          
                          // Style extraction
                          const hex = (accord.color && accord.color.startsWith('#')) ? accord.color : '#D97706';
                          const c = hex.substring(1);
                          const rgb = parseInt(c, 16);
                          const luma = 0.2126 * ((rgb >> 16) & 0xff) + 0.7152 * ((rgb >> 8) & 0xff) + 0.0722 * ((rgb >> 0) & 0xff);
                          const textColor = luma < 128 ? '#ffffff' : '#111111';

                          return (
                            <div 
                              key={accord._key}
                              class="w-full bg-gray-100 dark:bg-[#1a1a1a] rounded-r-[10px] flex items-center h-[28px] overflow-hidden transition-colors duration-500 border border-transparent dark:border-white/5"
                            >
                              <div 
                                class="h-full flex items-center justify-center font-bold text-[9px] uppercase tracking-[0.2em] transition-all duration-700 ease-out animate-grow-width font-sans rounded-r-[10px]"
                                style={`width: ${accord.value}%; background-color: ${hex};`}
                              >
                                <span class="px-3 truncate" style={`color: ${textColor};`}>{labelText}</span>
                              </div>
                            </div>
                          );
                        })}
                    </div>
                  )}

                  {(notes.top || notes.heart || notes.base) && (
                    <div class="space-y-4 mt-8 pt-6 border-t border-black/5 dark:border-white/5">
                      {notes.top && (
                        <div>
                          <span class="block text-xs uppercase tracking-widest opacity-50 mb-1">{t('product.topNotes')}</span>
                          <span>{notes.top}</span>
                        </div>
                      )}
                      {notes.heart && (
                        <div>
                          <span class="block text-xs uppercase tracking-widest opacity-50 mb-1">{t('product.heartNotes')}</span>
                          <span>{notes.heart}</span>
                        </div>
                      )}
                      {notes.base && (
                        <div>
                          <span class="block text-xs uppercase tracking-widest opacity-50 mb-1">{t('product.baseNotes')}</span>
                          <span>{notes.base}</span>
                        </div>
                      )}
                    </div>
                  )}
                </div>
              </details>

              <!-- SHIPPING & DELIVERY Accordion -->
              <details class="group border-b border-black/10 dark:border-white/10 transition-colors duration-500">
                <summary class="flex justify-between items-center font-medium cursor-pointer list-none py-6 text-xs tracking-[0.25em] uppercase hover:text-[#D97706] transition-colors duration-300">
                  <span>{t('product.shippingInfo')}</span>
                  <span class="transition duration-300 group-open:rotate-180">
                    <svg fill="none" height="18" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="18" class="text-gray-400 dark:text-white/50 group-hover:text-[#D97706]">
                      <path d="M6 9l6 6 6-6"></path>
                    </svg>
                  </span>
                </summary>
                <div class="pb-8 pt-2 text-gray-700 dark:text-[#D1D5DB] text-xs md:text-sm leading-[1.8] md:leading-loose tracking-wide opacity-80 animate-slide-down transition-colors duration-500">
                  {shippingText ? (
                    <p>{shippingText}</p>
                  ) : (
                    <div class="space-y-4">
                      <p>{t('product.shipping1')}</p>
                      <p>{t('product.shipping2')}</p>
                      <p>{t('product.shipping3')}</p>
                    </div>
                  )}
                </div>
              </details>
              
            </div>
            
            <!-- Call To Action -->
            <div class="pt-12 pb-4">
              <a href="https://wa.me/994505555555" target="_blank" rel="noopener" class="block w-full text-center border border-[#D97706] bg-[#D97706]/10 hover:bg-[#D97706] text-[#D97706] hover:text-white transition-colors duration-500 px-12 py-5 text-sm font-semibold tracking-widest uppercase w-full">
                {t('product.orderWhatsApp')}
              </a>
            </div>
          </div>
          
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* Override styles for the standard details summary marker */
  details > summary {
    list-style: none;
  }
  details > summary::-webkit-details-marker {
    display: none;
  }
  
  /* Smooth slide-down animation for details content */
  details[open] summary ~ * {
    animation: slideDown 0.3s ease-out;
  }
  
  @keyframes slideDown {
    0% {
      opacity: 0;
      transform: translateY(-10px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes growWidth {
    0% {
      width: 0%;
      opacity: 0;
    }
    100% {
      opacity: 1;
    }
  }

  .animate-grow-width {
    animation: growWidth 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
