---
import { sanityClient } from '../lib/sanity';
import imageUrlBuilder from '@sanity/image-url';

export interface Props {
  lang?: string;
}

const { lang = 'az' } = Astro.props;

const builder = imageUrlBuilder(sanityClient);
function urlFor(source) {
  return builder.image(source);
}

// Fetch 5 star products to feature on the shelf
let products = [];
try {
  products = await sanityClient.fetch(`
    *[_type == "product" && defined(logo)][0...5] {
      name,
      slug,
      logo,
      mainAccords
    }
  `);
} catch (error) {
  console.error("Failed to fetch products for shelf:", error);
}
---

<!-- Master Wrapper -->
<div class="living-shelf-hero relative w-full h-[75vh] min-h-[500px] overflow-hidden bg-[#180e09] flex items-center justify-center cursor-crosshair">
  
  <!-- The Spotlight Gradient (Warm Overhead Lighting) -->
  <div class="absolute inset-0 pointer-events-none z-0" style="background: radial-gradient(circle at 50% -10%, rgba(217, 119, 6, 0.15) 0%, rgba(255, 255, 255, 0.05) 30%, transparent 80%);"></div>
  
  <!-- Realistic Wood Texture Emulation via CSS lines & shadowing -->
  <div class="absolute inset-0 pointer-events-none opacity-30 mix-blend-multiply z-0" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 1px, rgba(0,0,0,0.1) 1px, rgba(0,0,0,0.1) 2px); background-size: 100% 4px;"></div>

  <!-- The Physical Wooden Shelf Base Line -->
  <div class="absolute bottom-[10%] left-0 w-full h-16 bg-gradient-to-b from-[#2a170e] to-[#0f0805] border-t border-[#4a2b1b] shadow-[0_30px_60px_rgba(0,0,0,0.9)] z-10"></div>
  
  <!-- Glass Reflection Map (Shelf Polish) -->
  <div class="absolute bottom-[2%] left-0 w-full h-[8%] bg-gradient-to-t from-transparent to-[rgba(255,255,255,0.02)] z-10 blur-sm pointer-events-none"></div>

  <!-- The Perfume Bottles -->
  <div class="bottles-container relative w-full max-w-7xl mx-auto flex items-end justify-center gap-6 md:gap-12 lg:gap-20 h-full pb-[11%] z-20">
    {products.map((p) => (
      <a href={p.slug?.current ? (lang === 'az' ? `/product/${p.slug.current}` : `/${lang}/product/${p.slug.current}`) : '#'} 
         class="shelf-bottle group relative flex flex-col items-center justify-end block no-underline outline-none" 
         data-accords={JSON.stringify(p.mainAccords)}>
         
        <!-- Bottle Image (Dynamic Drop Shadow applied via JS) -->
        <img 
           src={urlFor(p.logo).width(400).url()} 
           alt={p.name} 
           class="bottle-img w-20 sm:w-28 md:w-36 lg:w-44 h-auto object-contain relative z-20 transition-transform duration-[600ms] ease-[cubic-bezier(0.25,0.46,0.45,0.94)] group-hover:scale-110" 
           style="filter: drop-shadow(0px 30px 25px rgba(0,0,0,0.8));" 
        />
        
        <!-- Shelf Reflection of the Bottle (Glassy Mirage) -->
        <img 
           src={urlFor(p.logo).width(400).url()} 
           alt={`${p.name} reflection`} 
           class="absolute -bottom-1 left-0 w-full h-full object-contain origin-bottom scale-y-[-0.6] opacity-10 blur-[2px] z-10 pointer-events-none mix-blend-screen" 
        />
        
        <!-- Interactive Accord Cloud Anchor -->
        <div class="accord-cloud absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full z-10 pointer-events-none"></div>

        <!-- Typography Plaque (Hidden until hover) -->
        <div class="bottle-plaque absolute -bottom-16 left-1/2 -translate-x-1/2 w-[250%] text-center opacity-0 group-hover:opacity-100 group-hover:-translate-y-2 transition-all duration-[600ms] z-30 pointer-events-none">
           <h3 class="font-serif text-[#E6D5C3] group-hover:text-[#D97706] text-sm md:text-lg lg:text-xl tracking-[0.2em] uppercase truncate drop-shadow-md transition-colors">{p.name}</h3>
        </div>
      </a>
    ))}
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
     const hero = document.querySelector('.living-shelf-hero');
     const bottles = document.querySelectorAll('.shelf-bottle');
     let animationFrameId; // Debounce mechanism
     
     if(hero && bottles.length > 0) {
        
        // Parallax depth engine
        hero.addEventListener('mousemove', (e) => {
           if (animationFrameId) cancelAnimationFrame(animationFrameId);

           animationFrameId = requestAnimationFrame(() => {
              const { clientX, clientY } = e;
              const bounds = hero.getBoundingClientRect();
              
              // Local space relative to hero element
              const localX = clientX - bounds.left;
              const localY = clientY - bounds.top;

              const centerX = bounds.width / 2;
              const centerY = bounds.height / 2;
              
              const deltaX = (localX - centerX) / centerX; // -1 to 1
              const deltaY = (localY - centerY) / centerY; // -1 to 1

              bottles.forEach((bottle, i) => {
                 const img = bottle.querySelector('.bottle-img');
                 
                 // Deep Parallax Shift
                 // Slightly stagger the layers based on index to create 3D volume
                 const depthMulti = 1 + (i % 2 === 0 ? 0.2 : 0);
                 const shiftX = deltaX * (15 * depthMulti);
                 const shiftY = deltaY * (5 * depthMulti);
                 
                 bottle.style.transform = `translate(${shiftX}px, ${shiftY}px)`;
                 
                 // Shifting realistic shadow (Opposite to mouse)
                 const shadowX = -deltaX * 35;
                 const shadowY = Math.max(15, 30 + (-deltaY * 15));
                 
                 img.style.filter = `drop-shadow(${shadowX}px ${shadowY}px 25px rgba(0,0,0,0.85)) brightness(${1 + (deltaY * -0.1)})`;
              });
           });
        });

        // Snap back exactly when leaving the element
        hero.addEventListener('mouseleave', () => {
           if (animationFrameId) cancelAnimationFrame(animationFrameId);
           bottles.forEach(bottle => {
              bottle.style.transform = `translate(0px, 0px)`;
              bottle.style.transition = 'transform 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
              
              const img = bottle.querySelector('.bottle-img');
              img.style.filter = `drop-shadow(0px 30px 25px rgba(0,0,0,0.8)) tracking-[0.2em] brightness(1)`;
              img.style.transition = 'filter 0.8s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
              
              // Reset transitions organically
              setTimeout(() => {
                 bottle.style.transition = '';
                 img.style.transition = 'transform 600ms cubic-bezier(0.25,0.46,0.45,0.94)';
              }, 800);
           });
        });

        // Hover Effect "Breathing Accords" Particle System
        bottles.forEach(bottle => {
           const cloudContent = bottle.querySelector('.accord-cloud');
           const accordsRaw = bottle.getAttribute('data-accords');
           let particleIntervals = [];
           
           bottle.addEventListener('mouseenter', () => {
               if(accordsRaw && accordsRaw !== 'null' && cloudContent.children.length === 0) {
                  const accords = JSON.parse(accordsRaw);
                  
                  // Spawn particles
                  accords.forEach((acc, index) => {
                     const particle = document.createElement('span');
                     const name = typeof acc.name === 'object' ? (acc.name.en || acc.name.ru || acc.name.az) : acc.name;
                     if(!name) return;

                     particle.textContent = name;
                     particle.className = `absolute text-[9px] md:text-[11px] font-sans tracking-[0.2em] uppercase mix-blend-screen whitespace-nowrap pointer-events-none drop-shadow-md`;
                     particle.style.color = acc.color || '#D97706';
                     
                     // Radial spawn algorithm
                     const angle = (Math.PI * 2) * (index / accords.length);
                     const distanceX = 60 + Math.random() * 50;
                     const distanceY = -20 + Math.random() * -100; // Force them upwards
                     
                     particle.style.left = `50%`;
                     particle.style.top = `50%`;
                     
                     // Web Animations API
                     particle.animate([
                        { opacity: 0, transform: `translate(-50%, -50%) scale(0.6)` },
                        { opacity: 0.7, transform: `translate(calc(-50% + ${distanceX * 0.5}px), calc(-50% + ${distanceY * 0.5}px)) scale(1.1)`, offset: 0.5 },
                        { opacity: 0, transform: `translate(calc(-50% + ${distanceX}px), calc(-50% + ${distanceY}px)) scale(0.9)` }
                     ], {
                        duration: 3500 + (Math.random() * 2000),
                        iterations: Infinity,
                        delay: index * 250,
                        easing: 'ease-in-out'
                     });
                     
                     cloudContent.appendChild(particle);
                  });
               }
           });

           bottle.addEventListener('mouseleave', () => {
              // Fade out gently then remove
              Array.from(cloudContent.children).forEach(child => {
                 const anim = child.animate([{ opacity: child.style.opacity }, { opacity: 0 }], { duration: 300, fill: 'forwards' });
                 anim.onfinish = () => child.remove();
              });
           });
        });
     }
  });
</script>
