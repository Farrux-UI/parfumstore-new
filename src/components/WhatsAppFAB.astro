---
export interface Props {
  manager1?: string;
  manager2?: string;
}

const { manager1, manager2 } = Astro.props;

// Only show if at least one manager phone exists
const hasManagers = manager1 || manager2;
---

{hasManagers && (
  <>
    {/* WhatsApp FAB - Bottom Right with Safe Area */}
    <button
      id="whatsapp-fab"
      class="fixed bottom-[max(1rem,env(safe-area-inset-bottom))] right-[max(1rem,env(safe-area-inset-right))] z-50 w-14 h-14 rounded-full bg-white dark:bg-[#1a1a1a] shadow-2xl flex items-center justify-center transition-all duration-300 hover:scale-110 active:scale-95 border border-[#d4af37]/30"
      aria-label="Contact via WhatsApp"
    >
      <svg 
        viewBox="0 0 24 24" 
        class="w-7 h-7"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path 
          d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
          fill="#d4af37"
        />
      </svg>
    </button>

    {/* Bottom Sheet - Manager Selection */}
    <div
      id="whatsapp-bottomsheet"
      class="fixed inset-0 z-[60] pointer-events-none opacity-0 transition-opacity duration-300"
    >
      {/* Backdrop */}
      <div 
        id="bottomsheet-backdrop"
        class="absolute inset-0 bg-black/60 backdrop-blur-sm"
      />
      
      {/* Sheet Content */}
      <div 
        id="bottomsheet-content"
        class="absolute bottom-0 left-0 right-0 bg-[#1a120b] rounded-t-3xl p-6 pb-[max(1.5rem,env(safe-area-inset-bottom))] transform translate-y-full transition-transform duration-300 ease-out"
      >
        {/* Handle bar */}
        <div class="w-12 h-1 bg-white/20 rounded-full mx-auto mb-6" />
        
        {/* Title */}
        <h3 class="text-white text-lg font-semibold text-center mb-6 tracking-wide">
          Choose Manager to Connect via WhatsApp
        </h3>
        
        {/* Manager List */}
        <div class="space-y-3">
          {manager1 && (
            <a
              href={`whatsapp://send?phone=${manager1.replace(/\D/g, '')}`}
              class="flex items-center gap-4 p-4 rounded-xl bg-white/10 hover:bg-white/20 transition-colors duration-200 group"
            >
              <div class="w-12 h-12 rounded-full bg-[#d4af37]/20 flex items-center justify-center">
                <svg viewBox="0 0 24 24" class="w-6 h-6" fill="#d4af37">
                  <path d="M20 22h-2v-2a3 3 0 00-3-3H9a3 3 0 00-3 3v2H4v-2a5 5 0 015-5h6a5 5 0 015 5v2zm-8-9a6 6 0 110-12 6 6 0 010 12zm0-2a4 4 0 100-8 4 4 0 000 8z"/>
                </svg>
              </div>
              <div class="flex-1">
                <p class="text-white font-medium">Manager 1</p>
                <p class="text-[#d4af37] text-sm">{manager1}</p>
              </div>
              <svg viewBox="0 0 24 24" class="w-5 h-5 text-white/40 group-hover:text-white transition-colors" fill="currentColor">
                <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
              </svg>
            </a>
          )}
          
          {manager2 && (
            <a
              href={`whatsapp://send?phone=${manager2.replace(/\D/g, '')}`}
              class="flex items-center gap-4 p-4 rounded-xl bg-white/10 hover:bg-white/20 transition-colors duration-200 group"
            >
              <div class="w-12 h-12 rounded-full bg-[#d4af37]/20 flex items-center justify-center">
                <svg viewBox="0 0 24 24" class="w-6 h-6" fill="#d4af37">
                  <path d="M20 22h-2v-2a3 3 0 00-3-3H9a3 3 0 00-3 3v2H4v-2a5 5 0 015-5h6a5 5 0 015 5v2zm-8-9a6 6 0 110-12 6 6 0 010 12zm0-2a4 4 0 100-8 4 4 0 000 8z"/>
                </svg>
              </div>
              <div class="flex-1">
                <p class="text-white font-medium">Manager 2</p>
                <p class="text-[#d4af37] text-sm">{manager2}</p>
              </div>
              <svg viewBox="0 0 24 24" class="w-5 h-5 text-white/40 group-hover:text-white transition-colors" fill="currentColor">
                <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
              </svg>
            </a>
          )}
        </div>
        
        {/* Cancel Button */}
        <button
          id="bottomsheet-cancel"
          class="w-full mt-4 p-4 rounded-xl border border-white/20 text-white/70 hover:text-white hover:border-white/40 transition-all duration-200"
        >
          Cancel
        </button>
      </div>
    </div>

    <script>
      (function() {
        const fab = document.getElementById('whatsapp-fab');
        const bottomsheet = document.getElementById('whatsapp-bottomsheet');
        const backdrop = document.getElementById('bottomsheet-backdrop');
        const content = document.getElementById('bottomsheet-content');
        const cancelBtn = document.getElementById('bottomsheet-cancel');

        function openBottomSheet() {
          bottomsheet.classList.remove('pointer-events-none', 'opacity-0');
          bottomsheet.classList.add('pointer-events-auto', 'opacity-100');
          content.classList.remove('translate-y-full');
          content.classList.add('translate-y-0');
        }

        function closeBottomSheet() {
          content.classList.remove('translate-y-0');
          content.classList.add('translate-y-full');
          bottomsheet.classList.remove('pointer-events-auto', 'opacity-100');
          bottomsheet.classList.add('pointer-events-none', 'opacity-0');
        }

        fab?.addEventListener('click', openBottomSheet);
        backdrop?.addEventListener('click', closeBottomSheet);
        cancelBtn?.addEventListener('click', closeBottomSheet);

        // Close on escape key
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeBottomSheet();
        });
      })();
    </script>
  </>
)}
